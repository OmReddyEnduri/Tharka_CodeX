<service>
	<id>tharkacontestserver.exe</id>
	<name>TharkaContestServer</name>
	<description>Tharka LAN Contest Platform - backend server (contests, sync, judging API). Auto-starts on boot.</description>
	<executable>C:\Program Files\nodejs\node.exe</executable>
	<argument>--harmony</argument>
	<argument>C:\Users\Administrator\TharkaLabContest\TharkaContestPlatform\node_modules\node-windows\lib\wrapper.js</argument>
	<argument>--file</argument>
	<argument>C:\Users\Administrator\TharkaLabContest\TharkaContestPlatform\apps\server\server.js</argument>
	<argument>--scriptoptions=</argument>
	<argument>--log</argument>
	<argument>TharkaContestServer wrapper</argument>
	<argument>--grow</argument>
	<argument>0.5</argument>
	<argument>--wait</argument>
	<argument>2</argument>
	<argument>--maxrestarts</argument>
	<argument>3</argument>
	<argument>--abortonerror</argument>
	<argument>n</argument>
	<argument>--stopparentfirst</argument>
	<argument>undefined</argument>
	<argument>--maxretries</argument>
	<argument>60</argument>
	<logmode>rotate</logmode>
	<stoptimeout>30sec</stoptimeout>
	<serviceaccount>
		<domain>THARKA-PC-01</domain>
		<user>LocalSystem</user>
		<password></password>
	</serviceaccount>
	<workingdirectory>C:\Users\Administrator\TharkaLabContest\TharkaContestPlatform\apps\server</workingdirectory>
</service>