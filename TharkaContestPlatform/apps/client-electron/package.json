{
  "name": "tharka-codex",
  "version": "2026.265.39128",
  "description": "LAN contest platform - student desktop client",
  "author": "Tharka Lab Contest",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "prebuild": "node scripts/stamp-version.js && node ../../scripts/check-judge-cpp-drift.js",
    "build": "electron-builder"
  },
  "dependencies": {
    "electron-log": "^5.2.4",
    "electron-updater": "^6.3.9",
    "pidusage": "^4.0.1",
    "socket.io-client": "^4.8.3",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "app-builder-bin": "^5.0.0-alpha.10",
    "electron": "32.3.3",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.tharka.codex",
    "productName": "Tharka Codex",
    "executableName": "Tharka Codex",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "files": [
      "main.js",
      "preload.js",
      "relauncher.ps1",
      "db.js",
      "judge-cpp/**",
      "node_modules/**"
    ],
    "asarUnpack": [
      "relauncher.ps1"
    ],
    "extraResources": [
      {
        "from": "../client-web/dist",
        "to": "client-web-dist"
      }
    ],
    "publish": {
      "provider": "generic",
      "url": "http://192.168.1.101:3001/updates/",
      "channel": "latest"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "artifactName": "${productName}.exe",
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Tharka Codex",
      "include": "installer.nsh"
    }
  }
}
